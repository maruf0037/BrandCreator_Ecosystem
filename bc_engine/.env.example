# Port for the Express server to listen on
PORT=5000

# Google OAuth Configuration (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Database URIs
MONGO_URI=mongodb://localhost:27017/brandcreator
FRONTEND_URL=http://localhost:8080
SESSION_SECRET=your-session-secret-here

# MS SQL Server Database Configuration
SQL_SERVER=localhost
SQL_DATABASE=BrandCreator_HUBDB
SQL_USER=BrandCreatorUser
SQL_PASSWORD=your-secure-sql-password
SQL_ENCRYPT=false
SQL_TRUST_CERT=true

# AI Service Keys (Optional)
GEMINI_API_KEY=your-gemini-api-key-here

# Google Drive product image uploads (service account)
GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_PRODUCT_IMAGE_FOLDER_ID=your-shared-drive-folder-id
PRODUCT_IMAGE_MAX_UPLOAD_MB=8
PRODUCT_IMAGE_WEBP_QUALITY=78

# Meta Conversions API (CAPI) Configuration
META_PIXEL_ID=your-meta-pixel-id-here
META_ACCESS_TOKEN=your-meta-graph-api-access-token-here
META_TEST_EVENT_CODE=TEST12345

